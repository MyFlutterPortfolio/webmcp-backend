WEBMCP_ENV=development
WEBMCP_HTTP_ADDR=127.0.0.1:8080
# Never commit a real database credential. Set this only in the local shell or hosting secret manager.
WEBMCP_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
WEBMCP_DB_MIN_CONNS=2
WEBMCP_DB_MAX_CONNS=10
WEBMCP_SHUTDOWN_TIMEOUT=10s
WEBMCP_REQUEST_TIMEOUT=15s
WEBMCP_MAX_BODY_BYTES=1048576
# Comma-separated exact browser origins. Required for production.
WEBMCP_ALLOWED_ORIGINS=http://localhost:5173
# Provider-neutral OIDC JWT validation. Required in staging/production.
WEBMCP_JWT_ISSUER=https://id.example.com/tenant
WEBMCP_JWT_AUDIENCE=webmcp-api
WEBMCP_JWKS_URL=https://id.example.com/tenant/.well-known/jwks.json
WEBMCP_JWT_CLOCK_SKEW=30s

# Optional judge/demo access. This is a real short-lived viewer session,
# scoped to one pre-seeded business and goal. Never use a real user secret.
WEBMCP_GUEST_DEMO_ENABLED=false
WEBMCP_GUEST_DEMO_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEBMCP_GUEST_DEMO_USER_ID=guest-demo-user
WEBMCP_GUEST_DEMO_ORGANIZATION_ID=demo-organization
WEBMCP_GUEST_DEMO_BUSINESS_ID=demo-business
WEBMCP_GUEST_DEMO_GOAL_ID=demo-goal
WEBMCP_GUEST_DEMO_TOKEN_TTL=15m

# Agent chat is available with a safe deterministic fallback when no provider
# key is configured. Keep the Groq key server-side in the hosting secret
# manager; never expose it through Vite or WebMCP tool code.
WEBMCP_AGENT_CHAT_ENABLED=true
WEBMCP_GROQ_API_KEY=
WEBMCP_GROQ_FALLBACK_API_KEY=
WEBMCP_GROQ_FALLBACK_API_KEY_2=
WEBMCP_GROQ_MODEL=openai/gpt-oss-120b
WEBMCP_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
WEBMCP_GROQ_FALLBACK_MODEL_2=openai/gpt-oss-120b
WEBMCP_GROQ_BASE_URL=https://api.groq.com/openai/v1
WEBMCP_GROQ_MAX_OUTPUT_TOKENS=700
